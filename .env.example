# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — SECRETA, só no servidor (Vercel). Nunca colar no código.
SUPABASE_SERVICE_ROLE_KEY=

# Site público (sem /normato no final)
NEXT_PUBLIC_SITE_URL=https://arxum.com.br
NEXT_PUBLIC_CONTACT_EMAIL=contato@arxum.com.br
NEXT_PUBLIC_COMPANY_NAME=ARXUM group
NEXT_PUBLIC_COMPANY_CNPJ=

# Pagar.me (Configurações → Chaves). Use sk_test_ para testar, sk_ para produção.
PAGARME_SECRET_KEY=
# Gerados por: node scripts/pagarme-criar-planos.mjs
PAGARME_PLAN_SOLO_ID=
PAGARME_PLAN_PRO_ID=
# Senha longa e aleatória; vai no final da URL do webhook (?token=...)
PAGARME_WEBHOOK_TOKEN=
